{
  // Python tests (Testing tab, backend). Needs requirements-dev.txt installed
  // in the selected interpreter (pytest, pytest-asyncio, pytest-cov).
  // pyproject.toml already sets testpaths and asyncio_mode.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": ["backend/tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  // The tests import the package as `backend.app...` from the repository root.
  "terminal.integrated.env.osx": { "PYTHONPATH": "${workspaceFolder}" },
  "terminal.integrated.env.linux": { "PYTHONPATH": "${workspaceFolder}" },
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}" },

  // Frontend tests (Testing tab, Vitest extension). The Vitest config is in
  // frontend/, not the workspace root. "Run with Coverage" uses the v8
  // settings in frontend/vitest.config.ts.
  "vitest.rootConfig": "frontend/vitest.config.ts",
  "vitest.enable": true,

  "testing.automaticallyOpenTestResults": "neverOpen",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/coverage/**": true,
    "**/htmlcov/**": true
  }
}
